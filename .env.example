# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://elara:elara123@localhost:5432/elara_dev
DATABASE_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_dev
REDIS_CLUSTER_MODE=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# AWS / MinIO (Local Development)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=minio_access_key
AWS_SECRET_ACCESS_KEY=minio_secret_key
S3_BUCKET_PRIVATE=elara-media-private
S3_BUCKET_PUBLIC=elara-media-public
S3_ENDPOINT=http://localhost:9000

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Open Banking (To be decided: TrueLayer / GoCardless / Plaid)
OPEN_BANKING_PROVIDER=truelayer
OPEN_BANKING_CLIENT_ID=your_client_id
OPEN_BANKING_CLIENT_SECRET=your_client_secret
OPEN_BANKING_REDIRECT_URI=http://localhost:3000/payments/callback

# Mapbox
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token

# Typesense
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=dev_typesense_key

# Firebase
FIREBASE_PROJECT_ID=elara-dev
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project

# Mixpanel
MIXPANEL_TOKEN=your_mixpanel_token

# Email (SendGrid)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@elara.local

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+44

# MinIO (Local S3 Compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Service Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
ECOMMERCE_SERVICE_PORT=3002
LOGISTICS_SERVICE_PORT=3003
JOBTAP_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
MEDIA_SERVICE_PORT=3007
SEARCH_SERVICE_PORT=3008
WEBSITE_SERVICE_PORT=3009
ADMIN_SERVICE_PORT=3010
