{
  "name": "elara-backend",
  "version": "1.0.0",
  "description": "Elara Bangladesh Super App - Backend Microservices",
  "private": true,

  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nest build api-gateway",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod": "node dist/main",
    "start:auth": "nest start auth-service --watch",
    "start:auth:dev": "nest start auth-service --watch",
    "start:ecommerce": "nest start ecommerce-service --watch",
    "start:jobtap": "nest start jobtap-service --watch",
    "start:payment": "nest start payment-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:media": "nest start media-service --watch",
    "start:logistics": "nest start logistics-service --watch",
    "start:search": "nest start search-service --watch",
    "start:website": "nest start website-service --watch",
    "start:admin": "nest start admin-service --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "migration:generate": "typeorm migration:generate -d libs/database/src/data-source.ts",
    "migration:create": "typeorm migration:create",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d libs/database/src/data-source.ts",
    "migration:revert": "typeorm migration:revert -d libs/database/src/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register libs/database/seeds/index.ts",
    "seed:zones": "ts-node -r tsconfig-paths/register -e \"import('./libs/database/seeds/001-zones.seed').then(m => m.seedZones)\"",
    "db:reset": "npm run migration:revert && npm run migration:run && npm run seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@mapbox/mapbox-sdk": "^0.15.3",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^10.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^10.3.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.32.1",
    "nodemailer": "^6.9.7",
    "argon2": "^0.31.2",
    "aws-sdk": "^2.1535.0",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^5.2.1",
    "firebase-admin": "^12.0.0",
    "fluent-ffmpeg": "^2.1.2",
    "ioredis": "^5.8.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.2",
    "socket.io": "^4.6.1",
    "stripe": "^14.25.0",
    "twilio": "^5.11.1",
    "typeorm": "^0.3.19",
    "typesense": "^1.7.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
