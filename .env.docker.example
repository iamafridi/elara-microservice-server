# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=elara
DB_PASSWORD=elara123
DB_NAME=elara_dev

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_dev

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=30d

# Payment Gateway Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_key

# Email (Gmail)
EMAIL_PROVIDER=gmail
GMAIL_EMAIL=email
GMAIL_PASSWORD=passowrd
EMAIL_FROM_ADDRESS=noreply@elara.com
EMAIL_FROM_NAME=Elara

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Elara Platform
SMTP_FROM_EMAIL=noreply@elara.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Push Notifications (FCM)
FCM_SERVER_KEY=your_fcm_server_key

# Storage Configuration (MinIO/S3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1
AWS_S3_BUCKET=elara-media
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Typesense Search Configuration
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=dev_typesense_key
TYPESENSE_PROTOCOL=http

# CORS Configuration
CORS_ORIGIN=*

# Sentry Error Tracking (Optional)
SENTRY_DSN=

# Node Environment
NODE_ENV=production

# Service Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
MEDIA_SERVICE_PORT=3005
ECOMMERCE_SERVICE_PORT=3006
LOGISTICS_SERVICE_PORT=3009
JOBTAP_SERVICE_PORT=3010
SEARCH_SERVICE_PORT=3011
WEBSITE_SERVICE_PORT=3012
ADMIN_SERVICE_PORT=3013

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@elara.com
PGADMIN_DEFAULT_PASSWORD=admin123

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
